# Copy to .env and fill in. Never commit .env.

# --- TrueForge harness ---------------------------------------------------
# Local mode: `npx @truefoundry/trueforge` serves UI + API on 8790.
TRUEFORGE_BASE_URL=http://localhost:8790
# Only needed when the harness has OIDC login enabled (Settings -> Login).
# TRUEFORGE_TOKEN=

# --- Model ---------------------------------------------------------------
# Model FQN in `provider/model` form. The API key itself is NOT set here:
# TrueForge stores provider credentials in Settings -> Models, and agent
# specs reference models by name only.
TRUEFORGE_MODEL=anthropic/claude-sonnet-4-6
# Cheaper model used for the compliance/scrub subagent (Phase 6, optional).
TRUEFORGE_MODEL_CHEAP=anthropic/claude-haiku-4-5-20251001

# --- Canary ---------------------------------------------------------------
# Nothing to configure. The canary is minted inside the sandbox at run time by
# python/gen_data.py and read back through the file-download endpoint, because
# any value written here or in source would reach the model as part of the
# generator script and break the proof. See src/lib/canary.ts.

# --- Synthetic data generation --------------------------------------------
# Configured by flag, not by env, so the sandbox invocation and the local one
# are the same command:
#   pnpm gen:data                       300 rows, seed 20260822
#   pnpm gen:data -- --rows 500         override row count
#   pnpm gen:data -- --seed 7           override seed (does NOT change the canary)
